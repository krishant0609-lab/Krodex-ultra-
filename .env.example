# =============================================================
# KRODEX — environment variable template
# Phase 0: placeholders only. NO real values.
# Copy to .env (gitignored) and fill in when Phase 1 begins.
# =============================================================

# ---------- App ----------
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000

# ---------- Database (Supabase) ----------
# Local stack (npx supabase start):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me-locally
SUPABASE_SERVICE_ROLE_KEY=replace-me-locally-only-on-server
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------- Auth ----------
# JWT settings, provider keys, etc. Populated in Phase 1 / Phase 2.
AUTH_JWT_SECRET=replace-me-locally-min-32-chars
AUTH_JWT_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=2592000

# ---------- AI ----------
# Used by the AI layer (Phase 8). DO NOT commit real keys.
AI_PROVIDER=openai
AI_API_KEY=replace-me
AI_MODEL_DEFAULT=gpt-4o-mini
AI_MODEL_REASONING=gpt-4o
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# ---------- Storage (Supabase Storage buckets for question captures) ----------
STORAGE_BUCKET_ERROR_CAPTURES=error-captures
STORAGE_BUCKET_QUESTION_SNAPSHOTS=question-snapshots
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ---------- Security / Rate Limiting ----------
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AI_PER_MIN=20
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Email / Notifications ----------
EMAIL_PROVIDER=resend
EMAIL_API_KEY=replace-me
EMAIL_FROM_ADDRESS=no-reply@krodex.local
EMAIL_FROM_NAME=KRODEX

# Push (web push for notifications; populated later)
PUSH_PROVIDER=webpush
PUSH_VAPID_PUBLIC_KEY=replace-me
PUSH_VAPID_PRIVATE_KEY=replace-me-locally
PUSH_VAPID_SUBJECT=mailto:dev@krodex.local

# ---------- Feature flags ----------
# Phase 0: every domain feature flag is OFF until the underlying
# behavior is implemented and verified.
FEATURE_PLANNER_ENABLED=false
FEATURE_TESTS_ENABLED=false
FEATURE_ERROR_BANK_ENABLED=false
FEATURE_REVIEW_ENABLED=false
FEATURE_PROGRESS_ENABLED=false
FEATURE_AI_INSIGHTS_ENABLED=false
FEATURE_NOTIFICATIONS_ENABLED=false
FEATURE_CAPTURE_ENABLED=false
