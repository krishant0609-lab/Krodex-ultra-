{
  "name": "@krodex/api",
  "version": "0.0.0",
  "private": true,
  "description": "KRODEX — API service (Fastify 4.21+). Phase 0: health route only.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist *.tsbuildinfo coverage",
    "postinstall": "node ./scripts/patch-realtime-js.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/under-pressure": "^8.5.2",
    "@krodex/shared": "*",
    "@supabase/supabase-js": "^2.45.4",
    "fastify": "^4.28.1",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^2.1.1",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.1"
  }
}
