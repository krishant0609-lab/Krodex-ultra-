{
  "name": "@krodex/web",
  "version": "0.1.0-phase1",
  "private": true,
  "description": "KRODEX — web app (Next.js 14 App Router). Phase 6: route shells + data integration.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:fixture": "node tests/e2e/fixture-server.mjs",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "clean": "rimraf .next *.tsbuildinfo"
  },
  "dependencies": {
    "@krodex/shared": "0.1.0-phase1",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.59.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "^4.13.0",
    "eslint-config-next": "^14.2.15",
    "jsdom": "^25.0.0",
    "rimraf": "^5.0.10",
    "typescript": "^5.4.5",
    "vitest": "^2.1.1",
    "vitest-axe": "^0.1.0"
  }
}
