{
  "name": "krodex",
  "version": "0.0.0",
  "private": true,
  "description": "KRODEX — engineering foundation. Phase 0.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @krodex/api run dev",
    "dev:web": "npm --workspace @krodex/web run dev",
    "build": "npm-run-all build:shared build:api build:web",
    "build:shared": "npm --workspace @krodex/shared run build",
    "build:api": "npm --workspace @krodex/api run build",
    "build:web": "npm --workspace @krodex/web run build",
    "typecheck": "npm --workspace @krodex/shared run build && npm-run-all typecheck:shared typecheck:api typecheck:web",
    "typecheck:shared": "npm --workspace @krodex/shared run typecheck",
    "typecheck:api": "npm --workspace @krodex/api run typecheck",
    "typecheck:web": "npm --workspace @krodex/web run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --workspace @krodex/api run test",
    "test:watch": "npm --workspace @krodex/api run test:watch",
    "security:check": "npm audit --audit-level=moderate --omit=dev",
    "security:check:full": "npm audit --audit-level=moderate",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "smoke:test": "npm --workspace @krodex/api run test -- src/__tests__/phase15-smoke.test.ts",
    "audit:env": "node scripts/audit-env.mjs",
    "clean": "rimraf \"**/dist\" \"**/.next\" \"**/.turbo\" \"**/*.tsbuildinfo\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.10",
    "typescript": "^5.4.5"
  }
}
